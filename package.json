{
  "name": "eufy-time-lapse",
  "version": "0.1.0",
  "private": true,
  "description": "Construction time-lapse service for a eufy 4G LTE Cam S330 (T86P2).",
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "bin": {
    "timelapse": "src/cli.ts"
  },
  "scripts": {
    "timelapse": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@mega-yfue/eufy-sdk": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
