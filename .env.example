# Non-secret settings. Copy to .env (gitignored) on the host that runs the service.
# Hosted-CI secrets: https://github.com/jbaruch/eufy-time-lapse/settings/secrets/actions

# Eufy login. On the NAS these come from Docker secret files instead: run
# scripts/set-credentials.sh. Set them here only to run the CLI directly, for
# local development. Prefer a separate account with the camera shared to it:
# logins can't displace your phone app, and the service never sees your other
# Eufy devices. Create it in the eufy app, then share the camera from the owner.
# EUFY_EMAIL=service-account@example.com
# EUFY_PASSWORD=change-me

# Two-letter country the account was registered under.
EUFY_COUNTRY=US

# Optional. Only needed if the account can see more than one T86P2.
# Find it in the eufy app under the camera's device settings.
# EUFY_CAMERA_SERIAL=

# How the camera reaches the internet, confirmed by you in the eufy app.
# The probe can't pass without "cellular": the point is to prove the built-in SIM.
# TIMELAPSE_CAMERA_LINK=cellular
# TIMELAPSE_CELLULAR_OPERATOR=

# Smallest frame that counts as meeting quality. A smaller one is kept but marked
# degraded, and fails the probe. Default: native 4K
# TIMELAPSE_MIN_WIDTH=3840
# TIMELAPSE_MIN_HEIGHT=2160

# Where frames, reports, logs, and the Eufy session live. Default: ./data
# TIMELAPSE_DATA_PATH=./data

# Where scripts/set-credentials.sh keeps the login. Default: ~/.config/eufy-time-lapse
# TIMELAPSE_SECRETS_DIR=

# User the container runs as. Must own the data directory and the secret files.
# Find yours with `id -u` and `id -g`. Default: 1000
# TIMELAPSE_UID=1000
# TIMELAPSE_GID=1000

# GitHub Actions secret — set in repo Settings → Secrets and variables → Actions,
# NOT copied into .env:
#   https://github.com/jbaruch/eufy-time-lapse/settings/secrets/actions
# FLEET_DISPATCH_TOKEN — the token .github/workflows/review-trigger.yml reads to start the
#   review run in jbaruch/coding-policy. Create it with Actions: Read and write on
#   jbaruch/coding-policy.
FLEET_DISPATCH_TOKEN=
